---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const articles = (await getCollection("articles", ({ data }) => !data.draft))
  .sort(
    (a, b) =>
      new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
  );

function fmtCategory(c: string) {
  return c.replace(/-/g, " ");
}
---

<BaseLayout
  title="Settled — considered home goods, recommended honestly"
  description="Long-form picks for small-space kitchens. Real testing, no fluff, picks made on merit."
  wide
>
  <section class="index-hero">
    <h1>Picks for small-space kitchens.</h1>
    <p>We test what's supposed to make a small kitchen work. The picks that earn their place stay; the rest go in the donate pile.</p>
  </section>

  {articles.length === 0 && (
    <p style="color: var(--muted); font-style: italic; text-align: center;">
      First article coming soon.
    </p>
  )}

  {articles.length > 0 && (
    <div class="section-rule">The Edit</div>
  )}

  <ul class="article-grid">
    {articles.map((a) => (
      <li>
        <a class="article-card" href={`/${a.slug}`}>
          <div class="article-card__category">
            {fmtCategory(a.data.category)}
          </div>
          <h2>{a.data.title}</h2>
          <p class="article-card__desc">{a.data.description}</p>
          <div class="article-card__meta">
            {new Date(a.data.date).toLocaleDateString("en-US", {
              year: "numeric", month: "short", day: "numeric",
            })}
            · {Math.max(1, Math.round(a.data.wordCount / 220))} min read
          </div>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
